# TiDB Cloud (mysql2 connection string)
# Format: mysql://USER:PASSWORD@HOST:4000/DATABASE
DATABASE_URL=mysql://USERNAME:PASSWORD@HOST:4000/DATABASE

# Docker Compose local MySQL credentials
# Do not reuse these defaults in production.
MYSQL_ROOT_PASSWORD=REPLACE_WITH_STRONG_ROOT_PASSWORD
MYSQL_APP_USER=app_user
MYSQL_APP_PASSWORD=REPLACE_WITH_STRONG_APP_PASSWORD
MYSQL_DEV_ROOT_PASSWORD=REPLACE_WITH_STRONG_DEV_ROOT_PASSWORD

# REQUIRED for `docker compose build web`. Fed to the build as a BuildKit secret
# (so the password never lands in an image layer). `next build` prerenders
# DB-backed pages, so the database must be reachable during the build. This runs
# on the host, so use host.docker.internal:3307 — not the app_db:3306 used at
# runtime. Keep the user/password in sync with MYSQL_APP_USER / MYSQL_APP_PASSWORD.
BUILD_DATABASE_URL=mysql://app_user:REPLACE_WITH_STRONG_APP_PASSWORD@host.docker.internal:3307/my_game_store

# NextAuth v5
# Generate with: npx auth secret
AUTH_SECRET=REPLACE_WITH_OUTPUT_OF_npx_auth_secret
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to true in dev if you get UntrustedHost errors (127.0.0.1 vs localhost)
AUTH_TRUST_HOST=true

# AES-256 encryption key
# Supported formats: 64 hex chars, 32-byte UTF-8 string, or base64 for 32 bytes
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARS
# Optional key ID for newly encrypted data
ENCRYPTION_KEY_ID=current
# Optional previous keys for decryption during key rotation
# Format: old1=64_HEX_OR_BASE64_KEY;old2=64_HEX_OR_BASE64_KEY
ENCRYPTION_PREVIOUS_KEYS=

# CSRF protection secret (64 hex chars)
CSRF_SECRET=REPLACE_WITH_64_HEX_CHARS

# EasySlip API v2 slip verification (server-side only)
EASYSLIP_API_KEY=REPLACE_WITH_EASYSLIP_API_KEY

# Resend email API key (optional, but required for email receipts and verification)
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
EMAIL_FROM=SNAILSHOP <noreply@snailshop.app>

# Cloudflare Turnstile (bot protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=REPLACE_WITH_TURNSTILE_SITE_KEY
TURNSTILE_SECRET_KEY=REPLACE_WITH_TURNSTILE_SECRET_KEY

# Upstash Redis (rate limiting / cache)
# Required in production if you want cache/rate limit persistence.
UPSTASH_REDIS_REST_URL=REPLACE_WITH_UPSTASH_REDIS_REST_URL
UPSTASH_REDIS_REST_TOKEN=REPLACE_WITH_UPSTASH_REDIS_REST_TOKEN

# Trusted client-IP header for rate limiting.
# In production the app trusts ONLY cf-connecting-ip (set by Cloudflare) and
# ignores the spoofable x-forwarded-for / x-real-ip. Override this only if you
# front the app with a different trusted proxy/CDN that sets a known header.
# TRUSTED_PROXY_IP_HEADER=cf-connecting-ip

# CORS allowed origin
# Set this to your production frontend origin before deploy.
ALLOWED_ORIGIN=https://your-domain.com

# Protect cron/admin automation endpoints in production
CRON_SECRET=REPLACE_WITH_CRON_SECRET

# Cloudflare Tunnel (optional, recommended if self-hosting behind home internet/NAT)
CLOUDFLARE_TUNNEL_TOKEN=REPLACE_WITH_CLOUDFLARE_TUNNEL_TOKEN

# Cloudflare R2 bucket used by `npm run storage:migrate-r2 -- --apply`
CLOUDFLARE_R2_UPLOADS_BUCKET=my-game-store-uploads

# Cube.js analytics (optional)
NEXT_PUBLIC_CUBEJS_API_URL=http://localhost:4000/cubejs-api/v1
NEXT_PUBLIC_CUBEJS_API_TOKEN=REPLACE_WITH_CUBEJS_API_TOKEN

# SonarQube tooling DB password (only used by the `tooling` compose profile).
# Defaults to "sonar" if unset; override for any shared/non-loopback host.
SONAR_DB_PASSWORD=sonar
